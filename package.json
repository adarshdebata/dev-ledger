    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "simple-icons": "16.35.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "2.9.1"
